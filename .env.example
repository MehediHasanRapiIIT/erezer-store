# ============================================================================
# Erezer - local stack configuration
#
#   cp .env.example .env      then edit if you need different ports
#
# Two kinds of address appear below, and mixing them up is the single most
# common cause of a stack that "starts fine" but does not work:
#
#   *_HOST_PORT   ports published to YOUR machine. Change freely on a clash.
#   PUBLIC_*      URLs a BROWSER will use. They must match the published ports.
#
# Services talk to each other over the internal `erezer` network using service
# names (postgres, redis, minio, keycloak) - that is fixed and not configurable
# here, because it never varies.
# ============================================================================

# ── Published ports (host side) ─────────────────────────────────────────────
STORE_HOST_PORT=4200
ADMIN_HOST_PORT=4300
API_HOST_PORT=8080
KEYCLOAK_HOST_PORT=9090
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# ── Browser-facing URLs ─────────────────────────────────────────────────────
# Keep these in sync with the ports above. They are injected into the Angular
# bundles at container start (env.js) and into MinIO image URLs / email links.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_KEYCLOAK_URL=http://localhost:9090
PUBLIC_MINIO_URL=http://localhost:9000
PUBLIC_STORE_URL=http://localhost:4200
PUBLIC_ADMIN_URL=http://localhost:4300

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=delivery_app_v1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# ── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Keycloak (admin authentication) ─────────────────────────────────────────
# The realm is imported from delivery-backend/keycloak/ on FIRST boot only.
# Seeded operator login: admin / admin
KEYCLOAK_REALM=delivery-admin
KEYCLOAK_CLIENT_ID=delivery-admin-ui
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Customer JWT (storefront auth; must be >= 32 chars) ────────────────────
EREZER_JWT_SECRET=local-development-secret-change-this-in-production-min32

# ── Schema management ───────────────────────────────────────────────────────
# Flyway owns the schema (V1 is a full baseline), and `validate` proves the
# entity model still matches it - the same contract prod runs under.
# Set DDL_AUTO=update while iterating on entities.
FLYWAY_ENABLED=true
DDL_AUTO=validate
SHOW_SQL=false
LOG_LEVEL_ROOT=INFO

# ── Sentry (blank disables it entirely) ─────────────────────────────────────
SENTRY_DSN_BACKEND=
SENTRY_DSN_STORE=
SENTRY_DSN_ADMIN=
SENTRY_ENV=local

# ── Storefront extras ───────────────────────────────────────────────────────
META_PIXEL_ID=

# ── Container image registry (used by the prod overlay) ─────────────────────
IMAGE_REPO_OWNER=erezer
IMAGE_TAG=local

# ============================================================================
# PRODUCTION overlay only - ignored by the local stack.
# Used by: docker compose -f docker-compose.yml -f docker-compose.prod.yml
# ============================================================================

# ── Public hostnames (Caddy routes by these and provisions certs for them) ──
# Point every one of these at this host's public IP with an A/AAAA record
# BEFORE first boot, or Let's Encrypt validation will fail.
STOREFRONT_HOST=erezer.localhost
ADMIN_HOST=admin.erezer.localhost
API_HOST=api.erezer.localhost
KEYCLOAK_HOST=auth.erezer.localhost
MEDIA_HOST=media.erezer.localhost

# Operator address for Let's Encrypt renewal-failure notices.
ACME_EMAIL=ops@erezer.com
# Set to `local_certs` to rehearse the prod overlay against *.localhost using
# Caddy's internal CA. MUST be empty for real public hostnames.
CADDY_GLOBAL_EXTRA=local_certs

# Keycloak gets its own database, created on first boot by
# deploy/postgres-init/01-keycloak-db.sh.
KEYCLOAK_DB=keycloak

# ── Real SMTP (Mailpit does not run under the prod overlay) ────────────────
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@erezer.com
MAIL_FROM_NAME=Erezer

# ── bKash (blank keeps the backend in STUB mode) ───────────────────────────
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ── SMS gateway (STUB logs only; REST sends for real) ──────────────────────
SMS_MODE=STUB
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ── Backups ────────────────────────────────────────────────────────────────
# Local-only backups do NOT survive losing the host. Set the S3 values for
# off-host copies if this data matters.
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
