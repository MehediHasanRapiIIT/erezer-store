# ============================================================================
# Erezer - PRODUCTION environment (lives ONLY on the VM, at /opt/erezer/.env)
#
#   scp this file to the VM, rename it to .env, fill in every value marked
#   CHANGE ME, then `chmod 600 .env`.
#
# This file is NOT deployed by CI and is never committed. CI overwrites the
# compose files and deploy scripts on every run but never touches .env, so the
# VM stays the single owner of its own secrets.
#
# Generate each secret with:  openssl rand -base64 36
# ============================================================================

# ── Container images (must match your Docker Hub account) ───────────────────
# CI overrides IMAGE_TAG per deploy with the git SHA; the value here is only
# the fallback used when you run compose by hand on the VM.
IMAGE_REPO_OWNER=CHANGE_ME_dockerhub_username
IMAGE_TAG=latest

# ── Public hostnames ────────────────────────────────────────────────────────
# Every one of these needs a DNS A record pointing at this VM's public IP
# BEFORE first boot, or Let's Encrypt validation fails and Caddy serves nothing.
STOREFRONT_HOST=CHANGE_ME_shop.example.com
ADMIN_HOST=CHANGE_ME_admin.example.com
API_HOST=CHANGE_ME_api.example.com
KEYCLOAK_HOST=CHANGE_ME_auth.example.com
MEDIA_HOST=CHANGE_ME_media.example.com

# Where Let's Encrypt sends renewal-failure warnings. A real inbox you read.
ACME_EMAIL=CHANGE_ME_ops@example.com

# MUST be empty for real public hostnames. Set it to `local_certs` only when
# rehearsing this overlay against *.localhost with Caddy's internal CA.
CADDY_GLOBAL_EXTRA=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Set POSTGRES_DB explicitly. The postgres container creates whatever is named
# here and the backend's JDBC URL is built from the same variable, so leaving
# it unset in one place and not the other is how you get a backend that boots
# against a database nobody created.
POSTGRES_DB=delivery_app_v1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Keycloak gets its own database on the same server, created on first boot by
# deploy/postgres-init/01-keycloak-db.sh (which runs only on an EMPTY volume).
KEYCLOAK_DB=keycloak

# ── MinIO (object storage for product images, banners, return photos) ───────
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password

# ── Keycloak (admin-panel authentication) ──────────────────────────────────
KEYCLOAK_REALM=delivery-admin
KEYCLOAK_CLIENT_ID=delivery-admin-ui
# Same host as KEYCLOAK_HOST above, with the scheme. Compose does not need it
# (the prod overlay builds KC_HOSTNAME from KEYCLOAK_HOST), but
# deploy/keycloak_setup.py reads this key literally and would otherwise fall
# back to http://localhost:9090 - a port the prod overlay never publishes.
PUBLIC_KEYCLOAK_URL=https://CHANGE_ME_auth.example.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_keycloak_password
# Filled in by `python3 deploy/keycloak_setup.py` after the first boot - it
# creates the confidential client the backend uses to manage staff logins.
KEYCLOAK_ADMIN_CLIENT_ID=erezer-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── Customer JWT (storefront auth) ─────────────────────────────────────────
# Minimum 32 characters. Changing it invalidates every logged-in customer.
EREZER_JWT_SECRET=CHANGE_ME_min_32_chars_random_secret_here

# ── Schema management ──────────────────────────────────────────────────────
# Flyway owns the schema; Hibernate only verifies the entities still match it.
# Never set this to `update` on a live database.
JPA_DDL_AUTO=validate
LOG_LEVEL_ROOT=INFO

# ── Real SMTP (Mailpit does NOT run under the prod overlay) ────────────────
MAIL_HOST=CHANGE_ME_smtp.provider.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Erezer

# ── Business calendar (reports / dashboard) ────────────────────────────────
BUSINESS_ZONE=Asia/Dhaka
BUSINESS_WEEK_START=SUNDAY
BUSINESS_FISCAL_YEAR_START_MONTH=7
BUSINESS_CURRENCY=BDT

# ── Payments: bKash (blank keeps the backend in STUB mode) ─────────────────
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ── SMS gateway (STUB logs only; REST sends for real) ──────────────────────
SMS_MODE=STUB
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ── Storefront tracking (blank disables) ───────────────────────────────────
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ── Error reporting (blank disables) ───────────────────────────────────────
SENTRY_DSN_BACKEND=
SENTRY_DSN_STORE=
SENTRY_DSN_ADMIN=
SENTRY_ENV=prod

# ── Backups ────────────────────────────────────────────────────────────────
# A nightly pg_dump lands on a Docker volume on THIS host, which does not
# survive losing the host. Set the S3 values if the data matters.
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
